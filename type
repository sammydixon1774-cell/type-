<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>JARVIS</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle, #12384d 0%, #061018 45%, #020406 100%);
  color: #dff9ff;
  font-family: Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding: 25px 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status {
  font-size: 13px;
  letter-spacing: 3px;
  opacity: 0.7;
}

h1 {
  font-size: 48px;
  letter-spacing: 10px;
  margin: 15px 0;
  text-shadow: 0 0 25px #4ddfff;
}

.orb {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  border: 2px solid #70e5ff;
  box-shadow:
    0 0 20px #38cfff,
    0 0 60px #168db3,
    inset 0 0 35px #168db3;

  display: flex;
  align-items: center;
  justify-content: center;

  animation: pulse 2s infinite;
}

.orb::before {
  content: "";
  width: 85px;
  height: 85px;
  border-radius: 50%;
  border: 2px solid white;
  box-shadow: 0 0 25px #50ddff;
}

@keyframes pulse {
  50% {
    transform: scale(1.06);
  }
}

.clock {
  font-size: 22px;
  letter-spacing: 3px;
  margin: 20px;
}

.chat {
  width: 100%;
  max-width: 600px;
  height: 300px;
  overflow-y: auto;
  padding: 15px;
  border: 1px solid #248bab;
  border-radius: 18px;
  background: rgba(0,15,25,0.7);
}

.message {
  padding: 12px;
  margin: 8px 0;
  border-radius: 12px;
  line-height: 1.5;
}

.jarvis {
  background: rgba(40,160,200,0.15);
  border-left: 3px solid #58dcff;
}

.user {
  background: rgba(255,255,255,0.06);
  text-align: right;
  border-right: 3px solid #aaa;
}

.controls {
  width: 100%;
  max-width: 600px;
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 15px;
  border-radius: 14px;
  border: 1px solid #3bbfe5;
  background: #06121a;
  color: white;
  font-size: 16px;
}

button {
  border: none;
  border-radius: 14px;
  padding: 0 18px;
  background: #38cfff;
  color: #001018;
  font-weight: bold;
}

.mic {
  width: 100%;
  max-width: 600px;
  height: 50px;
  margin-top: 10px;
}
</style>
</head>

<body>

<div class="container">

<div class="status" id="status">
SYSTEM ONLINE
</div>

<h1>JARVIS</h1>

<div class="orb"></div>

<div class="clock" id="clock">
00:00:00
</div>

<div class="chat" id="chat">

<div class="message jarvis">
Good day. I am JARVIS. How may I assist you?
</div>

</div>

<div class="controls">

<input
id="input"
placeholder="Ask JARVIS anything..."
>

<button onclick="sendMessage()">
SEND
</button>

</div>

<button class="mic" onclick="startVoice()">
🎙️ TALK TO JARVIS
</button>

</div>

<script>

function updateClock() {

const now = new Date();

document.getElementById("clock").textContent =
now.toLocaleTimeString();

}

setInterval(updateClock, 1000);

updateClock();


function addMessage(text, type) {

const message = document.createElement("div");

message.className = "message " + type;

message.textContent = text;

document.getElementById("chat").appendChild(message);

const chat = document.getElementById("chat");

chat.scrollTop = chat.scrollHeight;

}


function sendMessage() {

const input = document.getElementById("input");

const text = input.value.trim();

if (!text) return;

addMessage(text, "user");

input.value = "";


/*
TEMPORARY JARVIS BRAIN

We'll connect the real AI
in the next step.
*/

let answer =
"I received your message: " + text;

addMessage(answer, "jarvis");

speak(answer);

}


function speak(text) {

if (!("speechSynthesis" in window))
return;

const speech =
new SpeechSynthesisUtterance(text);

speech.rate = 0.95;

speech.pitch = 0.85;

speechSynthesis.cancel();

speechSynthesis.speak(speech);

}


function startVoice() {

const Recognition =
window.SpeechRecognition ||
window.webkitSpeechRecognition;

if (!Recognition) {

alert("Voice input isn't supported here.");

return;

}

const recognition = new Recognition();

recognition.lang = "en-GB";

recognition.start();

document.getElementById("status").textContent =
"LISTENING...";


recognition.onresult = function(event) {

const text =
event.results[0][0].transcript;

document.getElementById("input").value =
text;

sendMessage();

};


recognition.onend = function() {

document.getElementById("status").textContent =
"SYSTEM ONLINE";

};

}

</script>

</body>
</html>
